{
  "manifest_version": 3,
  "name": "Meeting Lint",
  "version": "1.0",
  "description": "Real-time meeting audio analysis against your codebase",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "ws://localhost/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Meeting Lint"
  },
  "background": {
    "service_worker": "background.js"
  }
}
